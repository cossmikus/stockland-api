# ---- secrets only; tunables live in src/constants.ts ----
# Helius: dashboard.helius.dev → API Keys → eye icon. One key covers RPC and webhooks.
# Keys are per network in Helius: make one for Devnet and one for Mainnet, paste the one matching SOLANA_CLUSTER.
HELIUS_API_KEY=
# devnet for rehearsal (fake SOL/USDC, no xStocks, no Jupiter), mainnet-beta for the real $50 round trip
SOLANA_CLUSTER=devnet
# Base58 secret keys. Generated by scripts/setup-keys.sh into keys/ (git-ignored). Fee/crank only, never user funds.
CRANK_SECRET=
SPONSOR_SECRET=
# Program id after `anchor keys list` in the program repo
PROGRAM_ID=StockLand111111111111111111111111111111111
# Optional. Without it the API still moves money; receipts (estimated vs actual) are simply not stored.
DATABASE_URL=
# Protects /v1/admin/*. Any long random string.
ADMIN_TOKEN=
# Helius webhook auth header value, if you register a webhook for the indexer
HELIUS_WEBHOOK_SECRET=
# Server
PORT=8787
CORS_ORIGIN=http://localhost:3000,https://stockland.vercel.app
CRANK_ENABLED=false
